# =========================================================
# Node.js / Express / Next.js Universal .gitignore
# =========================================================

# dependencies
node_modules/

# logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# build folders
dist/
build/
out/

# Next.js
.next/

# Nuxt.js
.nuxt/

# Vite
vite.svg

# Turborepo
.turbo/

# Parcel
.parcel-cache/

# coverage
coverage/
.nyc_output/

# cache
.cache/
.eslintcache

# TypeScript
*.tsbuildinfo

# runtime files
pids
*.pid
*.seed
*.pid.lock

# OS generated files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Docker
.docker/
docker-compose.override.yml

# uploads / temp
uploads/
tmp/
temp/

# databases
*.sqlite
*.sqlite3
*.db

# package manager
.pnp
.pnp.js

# vercel
.vercel/

# misc
*.tgz
*.zip